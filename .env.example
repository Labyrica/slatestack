DATABASE_URL=postgresql://user:password@localhost:5432/slatestack
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# 8+ chars, do not ship default
ADMIN_PASSWORD=replace-me
# Generate with: openssl rand -hex 32
METRICS_SALT=replace-with-openssl-rand-hex-32
PORT=3000
NODE_ENV=development
# Comma-separated origins allowed for the admin SPA. Defaults to localhost dev.
# CORS_ORIGINS=https://admin.example.com
# Set to "true" or a comma-separated list of trusted proxy IPs when behind a load balancer.
# TRUST_PROXY=true
